{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".site-build/client",
  "installCommand": "npm ci",
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"Strict-Transport-Security","value":"max-age=31536000"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self' https://qcmirozomkxradixsuqt.supabase.co wss://qcmirozomkxradixsuqt.supabase.co; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"},
      {"key":"Cache-Control","value":"no-cache"}
    ]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
