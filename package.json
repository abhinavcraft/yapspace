{
  "name": "yapspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/validate-config.mjs && tsc -b && vite build && node scripts/check-build.mjs && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "check:setup": "node scripts/check-supabase.mjs",
    "verify": "npm test && npm run test:db && npm run build",
    "test:db:postgres": "node scripts/test-database.mjs",
    "test:live": "node scripts/test-live.mjs",
    "generate:setup": "node scripts/generate-setup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "pg": "8.23.1"
  }
}
