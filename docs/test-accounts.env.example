# Copy to .env.acceptance.local in the project root. Use a SEPARATE staging
# project, with all migrations and update-profile deployed. Accounts must already
# exist, have confirmed emails, and be disposable. Test messages remain in staging.
YAPSPACE_TEST_SUPABASE_URL=
YAPSPACE_TEST_SUPABASE_KEY=
YAPSPACE_TEST_A_EMAIL=
YAPSPACE_TEST_A_PASSWORD=
YAPSPACE_TEST_B_EMAIL=
YAPSPACE_TEST_B_PASSWORD=
YAPSPACE_TEST_C_EMAIL=
YAPSPACE_TEST_C_PASSWORD=
